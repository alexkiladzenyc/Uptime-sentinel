# Copy to .env for local development outside Docker.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sentinel
PORT=3000
LOG_LEVEL=info

# Optional: protect the UI and API with HTTP Basic auth.
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=change-me

# Optional: default Discord webhook for monitors that don't set their own.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

WORKER_CONCURRENCY=4
