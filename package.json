{
  "name": "uptime-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Uptime and SSL-certificate monitoring, powered by a crash-safe job queue built from scratch on Postgres.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:web": "npm --prefix web run build",
    "dev:api": "tsx watch src/bin/api.ts",
    "dev:worker": "tsx watch src/bin/worker.ts",
    "migrate": "tsx src/bin/migrate.ts",
    "start:api": "node dist/bin/api.js",
    "start:worker": "node dist/bin/worker.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:chaos": "vitest run --project chaos"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.5",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
